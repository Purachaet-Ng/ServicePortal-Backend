
# Pooled connection — used by the app at runtime
DATABASE_URL="URL"

# Same database WITHOUT the pooler (Neon: drop "-pooler" from the host).
# Used only by the Prisma CLI for migrations; the pooler cannot hold the
# advisory lock that `prisma migrate` requires.
DIRECT_URL="URL"



# Auth
JWT_SECRET_KEY="~~~~~~~~~~~~~~~"
JWT_SECRET_KEY_ADMIN_DEPT=="~~~~~~~~~~~~~~~"
JWT_SECRET_KEY_ADMIN_SYSTEM=="~~~~~~~~~~~~~~~"
JWT_EXPIRES_IN="7d"

# Signs event check-in QR tokens separately from login tokens
EVENT_QR_SECRET="~~~~~~~~~~~~~~~"


# Origin allowed to call the API (the Vite dev server)
CORS_ORIGIN=="~~~~~~~~~~~~~~~"

# Seed — password given to every seeded demo account
SEED_PASSWORD="~~~~~~~~~~~~~"


# Email notifications — entirely optional. With SMTP_HOST unset, notifications
# are written in-app only and nothing here is read.
# Gmail needs an App Password (2FA on the account), not the login password;
# Mailtrap or nodemailer.createTestAccount() avoids real credentials in a
# shared repo. Links in the mail are built from CORS_ORIGIN above.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Helpdesk <noreply@example.com>"
