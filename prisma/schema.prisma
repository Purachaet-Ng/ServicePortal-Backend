generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_SYSTEM
  ADMIN_DEPT
  STAFF
}

enum TicketStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Shared by room_bookings and car_bookings. Every reservation is created
// PENDING and only an admin moves it on — see the state machine in API.md.
enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventStatus {
  PENDING
  APPROVE
  IN_PROGRESS
  LIVE
  CLOSED
  CANCEL
}

enum EventAttendeeStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  ABSENT
}

// ---------------- Shared tables ----------------

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  users        User[]
  requestTypes RequestType[]

  @@map("departments")
}

model User {
  id           Int         @id @default(autoincrement())
  firstname    String
  lastname     String
  phone        String?
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         Role        @default(STAFF)
  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  createdTickets  Ticket[]        @relation("TicketCreatedBy")
  assignedTickets Ticket[]        @relation("TicketAssignedTo")
  comments        Comment[]
  notifications   Notification[]
  roomBookings    RoomBooking[]
  carBookings     CarBooking[]
  organizedEvents Event[]
  eventAttendance EventAttendee[]

  // Reservations this user approved or rejected, as an admin.
  approvedRoomBookings RoomBooking[] @relation("RoomBookingApprover")
  approvedCarBookings  CarBooking[]  @relation("CarBookingApprover")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ---------------- Ticketing module ----------------

model RequestType {
  id                Int        @id @default(autoincrement())
  departmentId      Int        @map("department_id")
  department        Department @relation(fields: [departmentId], references: [id])
  name              String
  description       String?
  formSchema        Json       @map("form_schema")
  defaultAssigneeId Int?       @map("default_assignee_id")

  tickets Ticket[]

  @@map("request_types")
}

model Ticket {
  id            Int         @id @default(autoincrement())
  requestTypeId Int         @map("request_type_id")
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])

  title        String
  description  String?
  status       TicketStatus @default(SUBMITTED)
  priority     Priority     @default(MEDIUM)
  customFields Json         @map("custom_fields")

  createdById  Int   @map("created_by")
  createdBy    User  @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId Int?  @map("assigned_to")
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tickets")
}

// ---------------- Reserve module: rooms and cars ----------------
// Rooms and cars stay separate tables — they hold different columns and are
// owned by different people. They meet in the UI, not in the database. The one
// thing both must get identical is the overlap check, which lives in a single
// shared helper (src/utils/timeOverlap.js) that both services call.

model Room {
  id       Int     @id @default(autoincrement())
  name     String
  location String?
  capacity Int

  bookings RoomBooking[]

  @@map("rooms")
}

model RoomBooking {
  id           Int               @id @default(autoincrement())
  roomId       Int               @map("room_id")
  room         Room              @relation(fields: [roomId], references: [id])
  userId       Int               @map("user_id")
  user         User              @relation(fields: [userId], references: [id])
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       ReservationStatus @default(PENDING)
  approvedById Int?              @map("approved_by")
  approvedBy   User?             @relation("RoomBookingApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  // The overlap query filters on roomId and both times together.
  @@index([roomId, startTime, endTime])
  @@map("room_bookings")
}

model Car {
  id       Int     @id @default(autoincrement())
  name     String
  plate    String  @unique
  seats    Int
  location String?

  bookings CarBooking[]

  @@map("cars")
}

model CarBooking {
  id           Int               @id @default(autoincrement())
  carId        Int               @map("car_id")
  car          Car               @relation(fields: [carId], references: [id])
  userId       Int               @map("user_id")
  user         User              @relation(fields: [userId], references: [id])
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       ReservationStatus @default(PENDING)
  approvedById Int?              @map("approved_by")
  approvedBy   User?             @relation("CarBookingApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([carId, startTime, endTime])
  @@map("car_bookings")
}

// ---------------- Events module ----------------

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  organizerId Int         @map("organizer_id")
  organizer   User        @relation(fields: [organizerId], references: [id])
  status      EventStatus @default(PENDING)

  attendees EventAttendee[]

  @@map("events")
}

model EventAttendee {
  eventId    Int                 @map("event_id")
  event      Event               @relation(fields: [eventId], references: [id])
  userId     Int                 @map("user_id")
  user       User                @relation(fields: [userId], references: [id])
  rsvpStatus EventAttendeeStatus @default(INVITED) @map("rsvp_status")

  @@id([eventId, userId])
  @@map("event_attendees")
}

// ---------------- Cross-cutting shared tables ----------------
// entityType + entityId let one table hold comments for tickets, bookings, or events
// without a separate comments table per module. Not enforced as a DB-level FK.

model Comment {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}
