generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_SYSTEM
  ADMIN_DEPT
  STAFF
}

enum TicketStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Shared by room_bookings and car_bookings. Every reservation is created
// PENDING and only an admin moves it on — see the state machine in API.md.
enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventStatus {
  PENDING
  APPROVE
  IN_PROGRESS
  LIVE
  CLOSED
  CANCEL
}

enum EventAttendeeStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  ABSENT
}

enum InventoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum InventoryAssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum StockMovementType {
  IN
  RESERVE
  RELEASE
  OUT
  RETURN
  ADJUST
}

// ---------------- Shared tables ----------------

model Department {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  users             User[]
  requestTypes      RequestType[]
  inventoryStocks   DepartmentStock[]
  inventoryRequests InventoryRequest[]

  @@map("departments")
}

model User {
  id           Int         @id @default(autoincrement())
  firstname    String
  lastname     String
  phone        String?
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         Role        @default(STAFF)
  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  createdTickets            Ticket[]           @relation("TicketCreatedBy")
  assignedTickets           Ticket[]           @relation("TicketAssignedTo")
  comments                  Comment[]
  notifications             Notification[]
  roomBookings              RoomBooking[]
  carBookings               CarBooking[]
  organizedEvents           Event[]
  eventAttendance           EventAttendee[] @relation("EventAttendeeUser")
  eventCheckins             EventAttendee[] @relation("EventCheckinBy")
  inventoryRequests         InventoryRequest[] @relation("InventoryRequester")
  reviewedInventoryRequests InventoryRequest[] @relation("InventoryReviewer")
  stockMovements            StockMovement[]
  assetAssignments          AssetAssignment[]
  uploadedAttachments       Attachment[]

  // Reservations this user approved or rejected, as an admin.
  approvedRoomBookings RoomBooking[] @relation("RoomBookingApprover")
  approvedCarBookings  CarBooking[]  @relation("CarBookingApprover")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ---------------- Ticketing module ----------------

model RequestType {
  id                Int        @id @default(autoincrement())
  departmentId      Int        @map("department_id")
  department        Department @relation(fields: [departmentId], references: [id])
  name              String
  description       String?
  formSchema        Json       @map("form_schema")
  defaultAssigneeId Int?       @map("default_assignee_id")

  tickets Ticket[]

  @@map("request_types")
}

model Ticket {
  id            Int         @id @default(autoincrement())
  requestTypeId Int         @map("request_type_id")
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])

  title        String
  description  String?
  status       TicketStatus @default(SUBMITTED)
  priority     Priority     @default(MEDIUM)
  customFields Json         @map("custom_fields")

  createdById  Int   @map("created_by")
  createdBy    User  @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId Int?  @map("assigned_to")
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tickets")
}

// A real FK with onDelete: Cascade, NOT the polymorphic entity_type/entity_id
// shape Comment uses - that shape is exactly why deleteTicket() has to
// hand-clear comments in a transaction. Widen this to other modules only when
// a second one actually needs attachments.
model Attachment {
  id       Int    @id @default(autoincrement())
  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // What the user called it (shown in the UI) vs. what is actually on disk (a
  // random name). Never join the two: an original filename is caller-supplied
  // and "../../.env" is a legal string.
  filename   String
  storedName String @map("stored_name")
  mimeType   String @map("mime_type")
  size       Int

  uploadedById Int  @map("uploaded_by")
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

// ---------------- Reserve module: rooms and cars ----------------
// Rooms and cars stay separate tables — they hold different columns and are
// owned by different people. They meet in the UI, not in the database. The one
// thing both must get identical is the overlap check, which lives in a single
// shared helper (src/utils/timeOverlap.js) that both services call.

model Room {
  id       Int     @id @default(autoincrement())
  // Unique so the room list cannot grow two "Meeting Room A"s — a booking names
  // its room, and two rooms with one name make every booking ambiguous to read.
  //
  // citext, so "meeting room a" collides with "Meeting Room A" as well. A plain
  // unique index is case-SENSITIVE, and the pair of rooms it would let through
  // are indistinguishable to everyone except the database. The type carries the
  // rule, so every findUnique and every future query gets it for free — nothing
  // has to remember to call lower().
  name     String  @unique @db.Citext
  location String?
  capacity Int

  bookings RoomBooking[]

  @@map("rooms")
}

model RoomBooking {
  id           Int               @id @default(autoincrement())
  roomId       Int               @map("room_id")
  room         Room              @relation(fields: [roomId], references: [id])
  userId       Int               @map("user_id")
  user         User              @relation(fields: [userId], references: [id])
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       ReservationStatus @default(PENDING)

  // Why the room is wanted, and — if it was refused — why. Both are free text
  // and both are optional at the database level; the rule that a REJECTED
  // booking must carry a reason lives in bookingStatusSchema, because it is a
  // rule about one TRANSITION, not about the row. A row rejected before this
  // column existed has no reason, and a NOT NULL here could not have been added
  // without inventing one for it.
  purpose         String?
  rejectionReason String? @map("rejection_reason")

  approvedById Int?              @map("approved_by")
  approvedBy   User?             @relation("RoomBookingApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  // The overlap query filters on roomId and both times together.
  @@index([roomId, startTime, endTime])
  @@map("room_bookings")
}

model Car {
  id       Int     @id @default(autoincrement())
  name     String
  plate    String  @unique
  seats    Int
  location String?

  bookings CarBooking[]

  @@map("cars")
}

model CarBooking {
  id           Int               @id @default(autoincrement())
  carId        Int               @map("car_id")
  car          Car               @relation(fields: [carId], references: [id])
  userId       Int               @map("user_id")
  user         User              @relation(fields: [userId], references: [id])
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       ReservationStatus @default(PENDING)

  // The room twin's comment applies verbatim. For a car the purpose is usually
  // where it is going, which is the one thing a fleet admin cannot infer from
  // the dates.
  purpose         String?
  rejectionReason String? @map("rejection_reason")

  approvedById Int?              @map("approved_by")
  approvedBy   User?             @relation("CarBookingApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([carId, startTime, endTime])
  @@map("car_bookings")
}

// ---------------- Events module ----------------

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  organizerId Int         @map("organizer_id")
  organizer   User        @relation(fields: [organizerId], references: [id])
  status      EventStatus @default(PENDING)

  attendees EventAttendee[]

  @@map("events")
}

model EventAttendee {
  eventId    Int                 @map("event_id")
  event      Event               @relation(fields: [eventId], references: [id])
  userId     Int                 @map("user_id")
  user       User                @relation("EventAttendeeUser", fields: [userId], references: [id])
  rsvpStatus EventAttendeeStatus @default(INVITED) @map("rsvp_status")
  checkedInAt   DateTime?        @map("checked_in_at")
  checkedInById Int?             @map("checked_in_by_id")
  checkedInBy   User?            @relation("EventCheckinBy", fields: [checkedInById], references: [id])

  @@id([eventId, userId])
  @@map("event_attendees")
}

// ---------------- Cross-cutting shared tables ----------------
// entityType + entityId let one table hold comments for tickets, bookings, or events
// without a separate comments table per module. Not enforced as a DB-level FK.

model Comment {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  message   String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

// ---------------- Inventory module ----------------

model InventoryItem {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  name         String
  unit         String
  isSerialized Boolean  @default(false) @map("is_serialized")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stocks DepartmentStock[]

  @@map("inventory_items")
}

model DepartmentStock {
  id           Int           @id @default(autoincrement())
  departmentId Int           @map("department_id")
  department   Department    @relation(fields: [departmentId], references: [id])
  itemId       Int           @map("item_id")
  item         InventoryItem @relation(fields: [itemId], references: [id])
  onHand       Int           @default(0) @map("on_hand")
  reserved     Int           @default(0)
  minStock     Int           @default(0) @map("min_stock")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  assets       InventoryAsset[]
  requestLines InventoryRequestLine[]
  movements    StockMovement[]

  @@unique([departmentId, itemId])
  @@index([departmentId, isActive])
  @@map("department_stocks")
}

model InventoryAsset {
  id        Int                  @id @default(autoincrement())
  stockId   Int                  @map("stock_id")
  stock     DepartmentStock      @relation(fields: [stockId], references: [id])
  serialNo  String               @unique @map("serial_no")
  assetTag  String?              @unique @map("asset_tag")
  condition String?
  status    InventoryAssetStatus @default(AVAILABLE)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  requestLines InventoryRequestLine[]
  assignments  AssetAssignment[]

  @@index([stockId, status])
  @@map("inventory_assets")
}

model InventoryRequest {
  id               Int                    @id @default(autoincrement())
  requesterId      Int                    @map("requester_id")
  requester        User                   @relation("InventoryRequester", fields: [requesterId], references: [id])
  fromDepartmentId Int                    @map("from_department_id")
  fromDepartment   Department             @relation(fields: [fromDepartmentId], references: [id])
  reason           String?
  rejectionReason  String?                @map("rejection_reason")
  status           InventoryRequestStatus @default(PENDING)
  reviewedById     Int?                   @map("reviewed_by_id")
  reviewedBy       User?                  @relation("InventoryReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?              @map("reviewed_at")
  fulfilledAt      DateTime?              @map("fulfilled_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  lines InventoryRequestLine[]

  @@index([requesterId, status])
  @@index([fromDepartmentId, status])
  @@map("inventory_requests")
}

model InventoryRequestLine {
  id        Int              @id @default(autoincrement())
  requestId Int              @map("request_id")
  request   InventoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stockId   Int              @map("stock_id")
  stock     DepartmentStock  @relation(fields: [stockId], references: [id])
  assetId   Int?             @map("asset_id")
  asset     InventoryAsset?  @relation(fields: [assetId], references: [id])
  quantity  Int

  movements   StockMovement[]
  assignments AssetAssignment[]

  @@index([requestId, stockId])
  @@index([stockId])
  @@map("inventory_request_lines")
}

model AssetAssignment {
  id            Int                   @id @default(autoincrement())
  assetId       Int                   @map("asset_id")
  asset         InventoryAsset        @relation(fields: [assetId], references: [id])
  userId        Int                   @map("user_id")
  user          User                  @relation(fields: [userId], references: [id])
  requestLineId Int?                  @map("request_line_id")
  requestLine   InventoryRequestLine? @relation(fields: [requestLineId], references: [id])
  assignedAt    DateTime              @default(now()) @map("assigned_at")
  returnedAt    DateTime?             @map("returned_at")
  conditionOut  String?               @map("condition_out")
  conditionIn   String?               @map("condition_in")

  @@index([assetId, returnedAt])
  @@index([userId, returnedAt])
  @@map("asset_assignments")
}

model StockMovement {
  id            Int                   @id @default(autoincrement())
  stockId       Int                   @map("stock_id")
  stock         DepartmentStock       @relation(fields: [stockId], references: [id])
  requestLineId Int?                  @map("request_line_id")
  requestLine   InventoryRequestLine? @relation(fields: [requestLineId], references: [id])
  actorId       Int                   @map("actor_id")
  actor         User                  @relation(fields: [actorId], references: [id])
  type          StockMovementType
  onHandDelta   Int                   @default(0) @map("on_hand_delta")
  reservedDelta Int                   @default(0) @map("reserved_delta")
  note          String?
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([stockId, createdAt])
  @@index([requestLineId])
  @@map("stock_movements")
}
